{
  "name": "monster-motion-studio",
  "version": "1.0.0",
  "private": true,
  "description": "A cinematic 10-second vertical Remotion motion graphics demo",
  "scripts": {
    "dev": "remotion studio src/index.ts --no-open",
    "typecheck": "tsc --noEmit",
    "build": "remotion bundle src/index.ts",
    "check": "npm run typecheck && npm run build",
    "compositions": "remotion compositions src/index.ts",
    "render": "remotion render src/index.ts MonsterMotion out/monster-motion.mp4 --concurrency=2",
    "yonko:review": "node scripts/yonko-render.mjs review",
    "yonko:short": "node scripts/yonko-render.mjs short",
    "yonko:main": "node scripts/yonko-render.mjs main",
    "yonko:verify": "python scripts/yonko-verify.py",
    "yonko:score": "python scripts/yonko_score.py",
    "yonko:master": "python scripts/yonko-master.py 150 15"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
